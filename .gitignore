/bin/
/local/answers.yaml
/local/local.env
/local/out/
/zone-setup.yaml
__pycache__/

# From https://github.com/github/gitignore/blob/main/community/Golang/Go.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor, IDE and development environment specific patterns belong in your own
# ~/.gitignore, not here.
