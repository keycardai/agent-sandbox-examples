# Settings for go run ./cmd/sandbox. `sandbox init` writes them to
# local/local.env, which is gitignored. To write that file by hand, copy this
# one. The steps read it as data and never execute it. Each
# line is blank, a # comment, or KEY=value for one of the keys below. The
# value is the rest of the line, taken literally, so it takes no quotes. Any
# other line stops the step. A flag wins over an exported variable
# of the same name, and an exported variable that is not empty wins over this
# file.

# The k3d cluster bootstrap.sh creates and down.sh deletes.
KEYCARD_LOCAL_CLUSTER=keycard-sandbox-local

# The ServiceAccount issuer. The API server stamps it into every token's iss.
# It is fixed when the cluster is created and cannot change afterwards. The
# zone fetches its discovery document and JWKS at this https URL, so it must
# reach the mirror. Leave it empty to use a quick tunnel from
# `sandbox tunnel`, which picks the URL. Set it to https://<hostname> for a
# named tunnel, or to a URL you publish yourself.
KEYCARD_LOCAL_ISSUER=

# The name of a Cloudflare tunnel in your account for `sandbox tunnel` to
# run. Leave it empty for a quick tunnel, which doesn't need an account.
KEYCARD_LOCAL_TUNNEL=

# The URL of the Keycard zone that decides every token exchange. run.sh does
# not create a zone.
KEYCARD_LOCAL_ZONE_URL=

# true for a zone that is not on the internet and answers on the Docker
# host. run.sh then sends the sandbox's exchanges to the cluster's
# Docker gateway. Empty dials the zone at the address its name resolves to.
KEYCARD_LOCAL_ZONE_ON_HOST=

# The zone-setup values file for that zone, relative to the repository root.
# Start from zone-setup.example.yaml.
KEYCARD_LOCAL_ZONE_SETUP_VALUES=zone-setup.yaml

# The user the sandbox impersonates. zone-setup must enroll this email.
KEYCARD_LOCAL_USER_EMAIL=

# The GitHub login of that user's credential. checks.sh compares it with the
# login api.github.com/user returns. Empty accepts any login.
KEYCARD_LOCAL_GITHUB_LOGIN=

# The absolute path to a PEM file of roots to trust in addition to the system
# roots. Empty trusts only the system roots.
KEYCARD_LOCAL_CA_FILE=
